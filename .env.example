# Keep this path on a persistent, writable disk in production.
DATABASE_PATH=.data/relayforge.sqlite

# Exact HTTPS hostnames permitted by the deployment operator. Empty disables HTTPS.
RELAYFORGE_ALLOWED_HOSTS=
# Absolute path to a protected 32-byte master key outside this checkout.
RELAYFORGE_MASTER_KEY_FILE=
# The independent local receiver is an explicit, fixed loopback transport.
RELAYFORGE_REFERENCE_ENABLED=false
RELAYFORGE_REFERENCE_KEYS_FILE=
RELAYFORGE_REFERENCE_DATABASE=
